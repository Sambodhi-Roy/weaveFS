# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Custom project directories
bin/

# Environment files
.env
.env.*

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# CAS storage data directories 
weavefs_data*/
test_store_data*/

# Node identity keys.
*.key

# Where a running node publishes its client API port, for put/get/ls/rm to find.
# Runtime state, valid only while that process lives.
api.addr

# Node directories used by the end-to-end walkthrough in the README.
node_*/
